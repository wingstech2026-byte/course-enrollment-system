// app.rc - menu, accelerators, dialogs and icon.
#include "resource.h"
#include <windows.h>
#include <commctrl.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/////////////////////////////////////////////////////////////////////////////
// Icon
IDI_APPICON ICON "app.ico"

/////////////////////////////////////////////////////////////////////////////
// Menu
IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Save\tCtrl+S",               IDM_FILE_SAVE
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_FILE_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About",                      IDM_HELP_ABOUT
    END
END

/////////////////////////////////////////////////////////////////////////////
// Accelerators
IDR_ACCEL ACCELERATORS
BEGIN
    "S",            IDM_FILE_SAVE,              VIRTKEY, CONTROL, NOINVERT
END

/////////////////////////////////////////////////////////////////////////////
// Add Student dialog
IDD_ADD_STUDENT DIALOGEX 0, 0, 236, 112
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add Student"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Student &ID:",IDC_STATIC,12,16,64,8
    EDITTEXT        IDC_STUDENT_ID,82,14,142,14,ES_AUTOHSCROLL
    LTEXT           "&Name:",IDC_STATIC,12,38,64,8
    EDITTEXT        IDC_STUDENT_NAME,82,36,142,14,ES_AUTOHSCROLL
    LTEXT           "",IDC_DLG_ERROR,12,60,212,20,SS_NOPREFIX
    DEFPUSHBUTTON   "OK",IDOK,118,90,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,174,90,50,14
END

/////////////////////////////////////////////////////////////////////////////
// Add Course dialog
IDD_ADD_COURSE DIALOGEX 0, 0, 236, 134
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add Course"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Course &ID:",IDC_STATIC,12,16,64,8
    EDITTEXT        IDC_COURSE_ID,82,14,142,14,ES_AUTOHSCROLL
    LTEXT           "&Name:",IDC_STATIC,12,38,64,8
    EDITTEXT        IDC_COURSE_NAME,82,36,142,14,ES_AUTOHSCROLL
    LTEXT           "&Capacity:",IDC_STATIC,12,60,64,8
    EDITTEXT        IDC_COURSE_CAPACITY,82,58,60,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_COURSE_CAPACITY_SPIN,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,130,58,11,14
    LTEXT           "",IDC_DLG_ERROR,12,82,212,20,SS_NOPREFIX
    DEFPUSHBUTTON   "OK",IDOK,118,112,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,174,112,50,14
END

/////////////////////////////////////////////////////////////////////////////
// About dialog
IDD_ABOUT DIALOGEX 0, 0, 232, 92
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_APPICON,IDC_STATIC,14,14,21,20
    LTEXT           "Course Enrollment Management System",IDC_STATIC,46,14,176,8
    LTEXT           "Version 1.0",IDC_STATIC,46,28,176,8
    LTEXT           "University course project written in C++17 with the native Win32 API and Common Controls.",IDC_STATIC,46,42,176,24
    DEFPUSHBUTTON   "OK",IDOK,172,70,50,14
END
